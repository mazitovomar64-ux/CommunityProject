# Скопируйте в .env и заполните. Реальный .env в Git не добавляйте.

# Длинная случайная строка (50+ символов). Сгенерировать:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# Этим же ключом подписываются JWT-токены — короткий ключ небезопасен.
SECRET_KEY=change-me

# Для разработки True, для сервера/Docker обязательно False
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Адреса фронтенда, которым разрешён доступ к API
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost

# Необязательно. Без REDIS_URL чат работает в памяти одного процесса.
# В Docker значение задаётся в docker-compose.yml.
# REDIS_URL=redis://127.0.0.1:6379/0

# Необязательно. Путь к файлу SQLite (по умолчанию db.sqlite3 в корне проекта).
# SQLITE_PATH=